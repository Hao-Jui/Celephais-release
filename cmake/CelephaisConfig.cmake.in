@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(MPI COMPONENTS CXX)
find_dependency(BLAS)
find_dependency(LAPACK)

# Production packages are FFTW-free.  An explicitly enabled development
# package retains the differential oracle and therefore its private static-link
# closure.
if(@CELEPHAIS_ENABLE_FFTW_ORACLE@)
    list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(FFTW)
    list(POP_FRONT CMAKE_MODULE_PATH)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CelephaisTargets.cmake")
check_required_components(Celephais)

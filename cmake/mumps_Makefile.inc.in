# Generated by Kadath CMake (cmake/BundledMUMPS.cmake) from
# cmake/mumps_Makefile.inc.in -- DO NOT EDIT.
#
# Builds the in-tree MUMPS (third_party/mumps) for production:
#   * double-precision arithmetic only (Kadath's MumpsLinearSolver is double)
#   * PORD + METIS ordering (PORD bundled in MUMPS; METIS from the in-tree
#     third_party/metis via cmake/BundledMetis.cmake. Auto-ordering
#     (ICNTL(7)=7) prefers METIS)
#   * real MPI (no libseq sequential stub)
#   * static archives only (numerical stack is linked by the Kadath build)
#   * no OpenMP: building the C files with clang's libomp and the Fortran files
#     with gfortran's libgomp in one executable clashes; MUMPS OpenMP is also a
#     no-op for Kadath's MPI-per-rank, BLAS-threads=1 workload.

########################################################################
# Orderings: PORD (bundled in MUMPS) + METIS (in-tree third_party/metis).
LPORDDIR    = $(topdir)/PORD/lib/
IPORD       = -I$(topdir)/PORD/include/
LPORD       = -L$(LPORDDIR) -lpord$(PLAT)
IMETIS      = @KADATH_MUMPS_IMETIS@
LMETIS      = @KADATH_MUMPS_LMETIS@
ORDERINGSF  = @KADATH_MUMPS_ORDERINGSF@
ORDERINGSC  = $(ORDERINGSF)
LORDERINGS  = $(LMETIS) $(LPORD)
IORDERINGSF =
IORDERINGSC = $(IMETIS) $(IPORD)

########################################################################
# Platform suffix, archiver, compilers.
PLAT          =
LIBEXT        = .a
LIBEXT_SHARED = .so
SONAME        = -soname
SHARED_OPT    = -shared
FPIC_OPT      = -fPIC
RM            = /bin/rm -f
OUTC          = @KADATH_MUMPS_OUTC@
OUTF          = @KADATH_MUMPS_OUTF@
CC            = @KADATH_MUMPS_CC@
FC            = @KADATH_MUMPS_FC@
FL            = @KADATH_MUMPS_FC@
AR            = @KADATH_MUMPS_AR@
RANLIB        = @KADATH_MUMPS_RANLIB@

########################################################################
# Numerical libraries. Only consumed when linking shared libraries or the
# example drivers -- neither of which the Kadath build requests (it builds the
# static archives and links BLAS/LAPACK/ScaLAPACK itself). Populated for
# completeness so a manual `make all`/`make allshared` still links.
LAPACK    = @KADATH_MUMPS_LAPACK@
SCALAP    = @KADATH_MUMPS_SCALAP@
LIBBLAS   = @KADATH_MUMPS_BLAS@
INCPAR    = @KADATH_MUMPS_INCPAR@
LIBPAR    = $(SCALAP) $(LAPACK) $(LIBBLAS)
INCSEQ    = -I$(topdir)/libseq
LIBSEQ    = $(LAPACK) -L$(topdir)/libseq -lmpiseq$(PLAT)
LIBOTHERS = @KADATH_MUMPS_LIBOTHERS@

########################################################################
# Fortran/C name mangling: gfortran and ifort/ifx append a single underscore.
CDEFS = -DAdd_

########################################################################
# Compiler options (see header note on OpenMP).
OPTF = @KADATH_MUMPS_OPTF@
OPTC = @KADATH_MUMPS_OPTC@
OPTL = @KADATH_MUMPS_OPTL@

########################################################################
# Parallel build (real MPI): no MUMPS sequential stub.
INCS         = $(INCPAR)
LIBS         = $(LIBPAR)
LIBSEQNEEDED =
